PREFIX ex: <https://example.org/semantic-lab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
SELECT ?projectName ?localLanguage ?wikidataEntity ?externalName
WHERE {
  GRAPH ex:local {
    ?project a ex:SoftwareProject ;
             rdfs:label ?projectName ;
             ex:usesLanguage ?language .
    ?language rdfs:label ?localLanguage ;
              skos:exactMatch ?wikidataEntity .
  }
  GRAPH ex:external {
    ?wikidataEntity rdfs:label ?externalName ; wdt:P31 wd:Q9143 .
    FILTER(LANG(?externalName) = "en")
  }
}
ORDER BY ?projectName ?externalName
